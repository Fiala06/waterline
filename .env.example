# Public URL of the app (required behind a proxy / in Docker)
ORIGIN=http://localhost:3000
# TEST ONLY: replaces Google with a fake sign-in form. Never enable on a real server.
AUTH_DEV_LOGIN=false
# Where the SQLite database, photos and the server's own keys live
DATA_DIR=./data
# Email is set up in the app (Settings › Server settings). For development,
# EMAIL_TRANSPORT=outbox writes emails to DATA_DIR/outbox instead of sending.
EMAIL_TRANSPORT=
# Everything else is set in the app, in Settings › Server settings. Optional
# overrides are in the README: AUTH_SECRET, ENCRYPTION_KEY,
# LOCAL_ADMIN_PASSWORD_HASH (a way back in), ADDRESS_HEADER and XFF_DEPTH.
