# Public URL of the app (required behind a proxy / in Docker)
ORIGIN=http://localhost:3000
# Random secret for session cookies: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <ORIGIN>/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# This Google account becomes the admin on first sign-in
ADMIN_EMAIL=
# Who else may sign in besides the admin, e.g. me@example.com,@family.example
ALLOWED_EMAILS=
# Or let anyone with a Google account sign up (off by default)
OPEN_SIGNUP=false
# Behind a reverse proxy: where the visitor's address is, for the admin login limit
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# Optional local admin fallback login (username defaults to "admin")
# Generate with: npm run hash-password (or hash-password in the Docker container)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD_HASH=
# Where the SQLite database and photos live
DATA_DIR=./data
# Encrypts stored mail passwords/API keys. If unset, derived from AUTH_SECRET.
# openssl rand -base64 32
ENCRYPTION_KEY=
# Email is configured by the admin in Server settings. For development,
# EMAIL_TRANSPORT=outbox writes emails to DATA_DIR/outbox instead of sending.
EMAIL_TRANSPORT=
# Reminders/digests run every 5 minutes; set to off to disable.
EMAIL_SCHEDULER=
# TEST ONLY: replaces Google with a fake sign-in form. Never enable on a real server.
AUTH_DEV_LOGIN=false
